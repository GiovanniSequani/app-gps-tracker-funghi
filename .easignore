# Dependencies and generated frontend output
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Native projects are generated by Expo prebuild on EAS
/ios/
/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Backend, datasets, tiles, logs, and local tooling are not used by the app bundle
/backend/
/legacy-funghi-index/
/docs/
/graphify-out/
/.agents/
/.codex/
/.pytest_cache/
/.graphify*
/.git/

# Local data and scientific artifacts
*.png
*.nc
*.tif
*.xml
*.geojson
*.vrt
*.npz
*.tar.gz
__pycache__/
icon_d2/

# Local configuration and debug files
.env
.env*.local
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem

# The app imports these tracked images; keep them even if image rules grow later.
!assets/
!assets/*.png
