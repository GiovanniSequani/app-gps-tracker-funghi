SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GDAL2TILES_EXE=
OSGEO4W_ROOT=
SUPABASE_UPLOAD_FILE_RETRIES=10
SUPABASE_UPLOAD_ROUNDS=3
SUPABASE_UPLOAD_ROUND_DELAY_SECONDS=30
SUPABASE_PUBLICATION_RETRIES=6
# Per-request timeouts keep a degraded gateway from making a publisher appear
# frozen for many minutes. Values are connect/read seconds.
SUPABASE_PUBLICATION_CONNECT_TIMEOUT_SECONDS=10
SUPABASE_PUBLICATION_TIMEOUT_SECONDS=30
# Proactively rotate the HTTP connection during long sequential publications.
# Set 0 only to disable this fallback while diagnosing a transport issue.
SUPABASE_PUBLICATION_CONNECTION_MAX_REQUESTS=12
SUPABASE_WEATHER_BATCH_SIZE=200
SUPABASE_TERRAIN_BUCKET=terrain
PIPELINE_COMPACT_LOGS=1

# Account lifecycle dispatcher (backend only; use a second dedicated Gmail App
# Password stored in the production worker secret store, never in a client or
# scheduler command line).
ACCOUNT_LIFECYCLE_SMTP_HOST=smtp.gmail.com
ACCOUNT_LIFECYCLE_SMTP_PORT=587
ACCOUNT_LIFECYCLE_SMTP_USERNAME=funghitracker@gmail.com
ACCOUNT_LIFECYCLE_SMTP_APP_PASSWORD=
ACCOUNT_LIFECYCLE_SMTP_FROM=funghitracker@gmail.com
# Human-readable transactional sender. Keep the mailbox unchanged until a
# custom authenticated domain is deliberately configured.
ACCOUNT_LIFECYCLE_SMTP_FROM_NAME=FunghiTracker
# Optional; defaults to ACCOUNT_LIFECYCLE_SMTP_FROM.
ACCOUNT_LIFECYCLE_SMTP_REPLY_TO=
ACCOUNT_LIFECYCLE_PUBLIC_ACCOUNT_URL=https://web-funghi-index.pages.dev/mappa/?account=1
ACCOUNT_LIFECYCLE_DAILY_LIMIT=100
ACCOUNT_LIFECYCLE_PAUSE_SECONDS=5
ACCOUNT_EXTERNAL_DELETION_URL=https://web-funghi-index.pages.dev/elimina-account/
ACCOUNT_LIFECYCLE_IMAP_HOST=imap.gmail.com
ACCOUNT_LIFECYCLE_IMAP_PORT=993
# Optional; if empty, the dedicated lifecycle SMTP App Password is reused.
ACCOUNT_LIFECYCLE_IMAP_APP_PASSWORD=
# Exact JSON list of automated Supabase Auth email subjects; never add support subjects.
ACCOUNT_AUTH_SERVICE_EMAIL_SUBJECTS_JSON=[]
